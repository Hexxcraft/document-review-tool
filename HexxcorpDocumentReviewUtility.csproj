<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>HexxcorpDocumentReviewUtility</AssemblyName>
    <RootNamespace>HexxcorpDocumentReviewUtility</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <!--  Also bundled as a WPF resource so Window.Icon="Assets/AppIcon.ico" can bind to it at runtime (ApplicationIcon above only covers the .exe's file-explorer icon).  -->
    <EmbeddedResource Include="Assets\Native\WebView2Loader.dll" />
  </ItemGroup>

</Project>
