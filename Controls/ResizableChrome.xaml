<UserControl x:Class="HexxcorpDocumentReviewUtility.Controls.ResizableChrome"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="7" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="7" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="7" />
        </Grid.RowDefinitions>

        <!--  Outer frame (behind the thumbs / content, purely visual)  -->
        <Border Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="2"
                SnapsToDevicePixels="True" />

        <!--  Header: drag-to-move bar with file name, zoom controls + close button  -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource NavyBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Thumb x:Name="PART_MoveThumb"
                   Grid.Column="0"
                   Background="Transparent"
                   Cursor="SizeAll"
                   DragDelta="MoveThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WhiteBrush}"
                                       Text="{Binding ElementName=Root, Path=FileName}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <Button Grid.Column="1"
                    Width="20"
                    Height="20"
                    Margin="0,1,0,1"
                    Click="ZoomOutButton_Click"
                    Content="&#8722;"
                    FontSize="11"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Zoom out (Ctrl+Scroll)" />
            <TextBlock x:Name="ZoomPercentText"
                       Grid.Column="2"
                       MinWidth="34"
                       Margin="2,0"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource GoldBrush}"
                       MouseLeftButtonDown="ZoomPercentText_MouseLeftButtonDown"
                       Text="100%"
                       TextAlignment="Center"
                       ToolTip="Click to reset zoom to 100%" />
            <Button Grid.Column="3"
                    Width="20"
                    Height="20"
                    Margin="0,1,2,1"
                    Click="ZoomInButton_Click"
                    Content="+"
                    FontSize="11"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Zoom in (Ctrl+Scroll)" />
            <Button Grid.Column="4"
                    Width="22"
                    Height="20"
                    Margin="0,1,1,1"
                    Click="RemoveButton_Click"
                    Content="&#10005;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Remove from workspace" />
        </Grid>

        <!--
            Content host: clipped so zoomed-in content never bleeds past the frame. A dedicated
            ScrollViewer wraps the (fixed-size) zoom host so that zooming in via a LayoutTransform
            (which, unlike a RenderTransform, changes the reported layout size) correctly grows the
            scrollable extent and keeps scrollbars/panning available at any zoom level. PDF content
            manages its own internal zoom/scroll (see PdfBoxControl.Zoom) so this outer scale is left
            at 1.0 for that content type and this ScrollViewer simply stays inert for it.
        -->
        <Border x:Name="ContentHost"
                Grid.Row="2"
                Grid.Column="1"
                Background="#FF1F2937"
                ClipToBounds="True"
                PreviewMouseWheel="ContentHost_PreviewMouseWheel">
            <ScrollViewer x:Name="ContentScrollViewer"
                          CanContentScroll="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ZoomHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ContentScale" />
                    </Grid.LayoutTransform>
                    <ContentPresenter Content="{Binding ElementName=Root, Path=InnerContent}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <!--  Resize thumbs (invisible, hit-test only)  -->
        <Thumb Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE" DragDelta="ResizeTopLeft_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
        <Thumb Grid.Row="0" Grid.Column="1" Cursor="SizeNS" DragDelta="ResizeTop_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
        <Thumb Grid.Row="0" Grid.Column="2" Cursor="SizeNESW" DragDelta="ResizeTopRight_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />

        <Thumb Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Cursor="SizeWE" DragDelta="ResizeLeft_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
        <Thumb Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Cursor="SizeWE" DragDelta="ResizeRight_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />

        <Thumb Grid.Row="3" Grid.Column="0" Cursor="SizeNESW" DragDelta="ResizeBottomLeft_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
        <Thumb Grid.Row="3" Grid.Column="1" Cursor="SizeNS" DragDelta="ResizeBottom_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
        <Thumb Grid.Row="3" Grid.Column="2" Cursor="SizeNWSE" DragDelta="ResizeBottomRight_DragDelta" Style="{StaticResource CanvasResizeThumbStyle}" />
    </Grid>
</UserControl>
