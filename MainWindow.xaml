<Window x:Class="HexxcorpDocumentReviewUtility.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HexxcorpDocumentReviewUtility"
        xmlns:controls="clr-namespace:HexxcorpDocumentReviewUtility.Controls"
        Title="Hexxcorp Document Review Utility"
        Width="320"
        Height="440"
        MinWidth="300"
        MinHeight="300"
        mc:Ignorable="d"
        Closing="MainWindow_Closing"
        Style="{StaticResource AppWindowStyle}"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="TrackerColumn" Width="0" />
        </Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0">
        <!--  Header bar & live clock  -->
        <Border Padding="18,14" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock FontSize="21" Style="{StaticResource HeaderTextStyle}" Text="Hexxcorp Document Review Utility" />
                <TextBlock Margin="0,10,0,0"
                           FontFamily="Segoe UI Semibold"
                           FontSize="30"
                           Foreground="{StaticResource GoldBrush}"
                           Text="{Binding CurrentTimeText}" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{Binding ThirtyDaysFromTodayText}" />
                    <Button Width="84"
                            Height="26"
                            Margin="0,2,0,0"
                            Click="DateDirectionToggleButton_Click"
                            Content="{Binding DateDirectionLabel}"
                            FontSize="11"
                            FontWeight="Bold"
                            Style="{StaticResource OutlineButtonStyle}"
                            ToolTip="Flip between Past (default) and Future" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="16,12,16,0" DockPanel.Dock="Top">
            <Button Height="36"
                    Margin="0,0,0,6"
                    Click="WorkspaceButton_Click"
                    Content="Workspace"
                    Style="{StaticResource GoldButtonStyle}" />
            <Button x:Name="TrackerToggleButton"
                    Height="36"
                    Margin="0,0,0,6"
                    Click="TrackerToggleButton_Click"
                    Content="Dates &amp; Work History &gt;"
                    Style="{StaticResource GoldButtonStyle}"
                    ToolTip="Open the Dates &amp; Employment History tracker / calculator" />
            <Button Height="36"
                    Click="MinimumsButton_Click"
                    Content="Review Criteria"
                    Style="{StaticResource GoldButtonStyle}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">

            </StackPanel>
        </ScrollViewer>
    </DockPanel>

        <Thumb x:Name="TrackerSplitter"
               Grid.Column="1"
               Visibility="Collapsed"
               Style="{StaticResource DrawerSplitterStyle}"
               DragDelta="TrackerSplitter_DragDelta" />
        <Border x:Name="TrackerDrawer"
                Grid.Column="2"
                Visibility="Collapsed"
                Background="{StaticResource NavyBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1,0,0,0">
            <controls:TrackerPanel x:Name="MainTrackerPanel" />
        </Border>
    </Grid>
</Window>
