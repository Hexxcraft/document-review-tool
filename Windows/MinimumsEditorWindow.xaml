<Window x:Class="HexxcorpDocumentReviewUtility.Windows.MinimumsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Review Criteria"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="460"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <Border Margin="0,0,0,12" Padding="14,10" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Edit Criteria" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="#FFCBD5E1"
                           Text="Add, remove, reorder, or adjust sections. Use **text** for bold, and start a line with &quot;- &quot; for a bullet." />
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Padding="10" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Click="SaveButton_Click"
                            Content="Save Changes"
                            Style="{StaticResource GoldButtonStyle}" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#FFCBD5E1" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Section list + reorder / add / remove controls  -->
            <DockPanel Grid.Column="0">
                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sections" DockPanel.Dock="Top" />

                <UniformGrid Margin="0,8,0,0" Columns="2" DockPanel.Dock="Bottom">
                    <Button Margin="0,0,4,4"
                            Click="AddSectionButton_Click"
                            Content="+ Add"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Margin="4,0,0,4"
                            Click="RemoveSectionButton_Click"
                            Content="Remove"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Margin="0,0,4,0"
                            Click="MoveSectionUpButton_Click"
                            Content="Move Up"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Margin="4,0,0,0"
                            Click="MoveSectionDownButton_Click"
                            Content="Move Down"
                            Style="{StaticResource OutlineButtonStyle}" />
                </UniformGrid>

                <Border Style="{StaticResource PanelBorderStyle}">
                    <ListBox x:Name="SectionsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             DisplayMemberPath="Title"
                             Foreground="{StaticResource WhiteBrush}"
                             SelectionChanged="SectionsListBox_SelectionChanged" />
                </Border>
            </DockPanel>

            <!--  Selected section's title / line editor  -->
            <DockPanel Grid.Column="2">
                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Section Title" DockPanel.Dock="Top" />
                <TextBox x:Name="TitleTextBox"
                         Margin="0,0,0,10"
                         DockPanel.Dock="Top"
                         Style="{StaticResource GoldTextBoxStyle}"
                         TextChanged="TitleTextBox_TextChanged" />

                <TextBlock Style="{StaticResource LabelTextStyle}"
                           Text="Lines (one entry per line)"
                           DockPanel.Dock="Top" />
                <TextBox x:Name="LinesTextBox"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         HorizontalScrollBarVisibility="Disabled"
                         Style="{StaticResource GoldTextBoxStyle}"
                         TextChanged="LinesTextBox_TextChanged"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
