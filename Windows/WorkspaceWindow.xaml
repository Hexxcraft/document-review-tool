                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone1Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4" BorderBrush="{StaticResource NavyLightBrush}" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone2Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone2Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4" BorderBrush="{StaticResource NavyLightBrush}" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone3Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone3Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4" BorderBrush="{StaticResource NavyLightBrush}" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone4Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone4Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4" BorderBrush="{StaticResource NavyLightBrush}" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone5Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone5Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4" BorderBrush="{StaticResource NavyLightBrush}" BorderThickness="0,0,1,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone6Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone6Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="6,4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Milestone7Label"
                                       HorizontalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}" />
                            <TextBlock x:Name="Milestone7Text"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource WhiteBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </DockPanel>
        </Border>

        <!--  Collapsible File Dates rules-engine panel.  -->
        <Border x:Name="FileDatesPanel"
                Padding="10,0,10,8"
                Background="{StaticResource NavyDarkBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Bottom"
                Visibility="Collapsed">
            <DockPanel>
                <Thumb x:Name="FileDatesPanelSplitter"
                       Height="8"
                       DockPanel.Dock="Top"
                       DragDelta="FileDatesPanelSplitter_DragDelta"
                       Style="{StaticResource HorizontalDrawerSplitterStyle}" />
                <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top" LastChildFill="False">
                    <TextBlock VerticalAlignment="Center"
                               DockPanel.Dock="Left"
                               FontSize="14"
                               Style="{StaticResource HeaderTextStyle}"
                               Text="File Dates" />
                    <TextBlock VerticalAlignment="Center" DockPanel.Dock="Left" Margin="16,0,4,0" FontSize="12" Foreground="{StaticResource GoldBrush}" x:Name="FileDatesTodayLabel" Text="TODAY:" /><TextBlock x:Name="FileDatesCurrentDateText" VerticalAlignment="Center" DockPanel.Dock="Left" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" />
                    <Button x:Name="ConflictListButton"
                            Padding="10,4"
                            Click="ConflictListButton_Click"
                            Content="Conflict List"
                            DockPanel.Dock="Right"
                            Style="{StaticResource GoldButtonStyle}" />
                </DockPanel>

                <Grid Grid.IsSharedSizeScope="True"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<Border Grid.Column="0" Grid.Row="0" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="7-DAY LOG" /><TextBox x:Name="SevenDayLogDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock x:Name="SolLabelText" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="STATEMENT OF LEASE" /><TextBox x:Name="StatementOfLeaseDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid x:Name="SolTrailerPanel" Grid.Column="1" Width="100" Visibility="Collapsed"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="SOL - TRAILER" /><TextBox x:Name="StatementOfLeaseTrailerDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></Grid></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="DAY QUALIFIED" /><TextBox x:Name="DayQualifiedDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="1" Grid.Row="0" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="CERTIFICATION" /><TextBox x:Name="CertificationDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="CDLIS / DAC" /><TextBox x:Name="CdlisDacDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="2" Grid.Row="0" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="LIMITED CONSENT" /><TextBox x:Name="LimitedConsentDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="FULL CONSENT" /><TextBox x:Name="FullConsentDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="3" Grid.Row="0" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="DRUG TEST RAN" /><TextBox x:Name="DrugTestRanDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="DrugTestExpHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="DRUG TEST RECEIVED" /><TextBox x:Name="DrugTestReceivedDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="4" Grid.Row="0" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="CDL EXPIRATION" /><TextBox x:Name="CdlExpirationDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="MVR-CDL EXPIRATION" /><TextBox x:Name="MvrCdlExpirationDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="0" Grid.Row="1" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="MVR LAST REVIEW" /><TextBox x:Name="MvrLastReviewDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="MvrLastReviewDateBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="MvrRanExpHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="MVR NEXT REVIEW" /><TextBox x:Name="MvrNextReviewDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8" IsReadOnly="True" Focusable="False" IsTabStop="False" Background="#FFE5E7EB" Foreground="#FF6B7280" ToolTip="Auto-calculated: MVR Last Review + 1 year" PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="1" Grid.Row="1" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="PHYSICAL LAST" /><TextBox x:Name="PhysicalLastDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="PHYSICAL NEXT" /><TextBox x:Name="PhysicalNextDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="PhysicalLookbackHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid></UniformGrid></Border>
<Border Grid.Column="2" Grid.Row="1" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="FINGERPRINT DATE" /><TextBox x:Name="FingerprintDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="FingerprintDateBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="FingerprintExpHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="HAZMAT ENDORSEMENT EXP." /><TextBox x:Name="HazmatExpirationDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /></Grid></UniformGrid></Border>
<Border Grid.Column="3" Grid.Row="1" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="LATEST JOB EV / ADDENDUM" /><TextBox x:Name="LatestJobEvDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="LatestJobEvExpHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid></UniformGrid></Border>
<Border Grid.Column="4" Grid.Row="1" Margin="3" Padding="6,4" Background="{StaticResource NavyLightBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><UniformGrid Rows="1"><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="PSP SNAPSHOT" /><TextBox x:Name="PspSnapshotDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="PspSnapshotDateBox_TextChanged" /></Grid><Grid Margin="3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" SharedSizeGroup="Hint" /></Grid.RowDefinitions><TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Text="PSP RAN" /><TextBox x:Name="PspRanDateBox" Grid.Row="1" MinHeight="30" Padding="6,2" MaxLength="8"  PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput" Style="{StaticResource GoldTextBoxStyle}" TextChanged="DateFieldTextBox_TextChanged" /><Border Grid.Row="2" Margin="0,3,0,0" Padding="6,4" MinHeight="30" Background="#FFE5E7EB" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="4"><TextBlock x:Name="PspExpHint" FontSize="12" FontWeight="SemiBold" Foreground="#FF374151" TextWrapping="Wrap" VerticalAlignment="Center" /></Border></Grid></UniformGrid></Border>
</Grid>
                
            </DockPanel>
        </Border>

        <!--  Toggle bar for the collapsible File Dates panel - sits directly above the revealed File Dates panel.  -->
        <Border Padding="10,4"
                Background="{StaticResource NavyBrush}"
                BorderBrush="{StaticResource NavyLightBrush}"
                BorderThickness="0,1,0,1"
                DockPanel.Dock="Bottom">
            <DockPanel LastChildFill="True">
                <Button x:Name="StoredFilesToggleButton"
                        Padding="10,4"
                        Click="ViewStoredFilesButton_Click"
                        Content="Stored Files"
                        DockPanel.Dock="Left"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Show/hide the document list for this workspace" />
                <Button x:Name="FileDatesToggleButton"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="FileDatesToggleButton_Click"
                        Content="File Dates"
                        DockPanel.Dock="Left"
                        FontWeight="Bold"
                        Style="{StaticResource OutlineButtonStyle}" />

                <Button x:Name="NotesToggleButton"
                        Padding="10,4"
                        Click="NotesToggleButton_Click"
                        Content="View/Edit Doc"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}" />
                <Button x:Name="SheetToggleButton"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Click="SheetToggleButton_Click"
                        Content="View/Edit Sheet"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Show/hide the embedded Excel spreadsheet viewer" />
                <Button x:Name="BrowserToggleButton"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Click="BrowserToggleButton_Click"
                        Content="Browser"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Show/hide the embedded web browser" />
                <Button x:Name="TrackerToggleButton"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Click="TrackerToggleButton_Click"
                        Content="Work History"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Show/hide the Work History tracker (program, date calculator, employment history)" />
                <Button x:Name="CopilotToggleButton"
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Click="CopilotToggleButton_Click"
                        Content="Assistant"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}"
                        ToolTip="Show/hide the qualification assistant" />
            </DockPanel>
        </Border>

        <!--  Canvas area with the left-edge document drawer  -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DrawerColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Document drawer: lists every image/PDF/Word doc currently in this workspace - opened via the "Stored Files" button in the File Dates toggle bar  -->
            <Grid x:Name="DrawerHost"
                  Grid.Column="0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="DrawerPanel"
                        Grid.Column="0"
                        AllowDrop="True"
                        DragOver="Canvas_DragOver"
                        Drop="DrawerPanel_Drop"
                        Focusable="True"
                        PreviewKeyDown="DrawerPanel_PreviewKeyDown"
                        PreviewMouseLeftButtonDown="DrawerPanel_PreviewMouseLeftButtonDown"
                        Margin="0,0,2,0"
                        Background="{StaticResource NavyDarkBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="2"
                        ClipToBounds="True">
                    <DockPanel>
                        <Button Margin="8"
                                Padding="0,6"
                                Click="DrawerSaveAllButton_Click"
                                Content="Save All"
                                DockPanel.Dock="Top"
                                Style="{StaticResource GoldButtonStyle}" />
                        <Button Margin="8,0,8,8"
                                Padding="0,6"
                                Click="DrawerSaveSelectedButton_Click"
                                Content="Save File"
                                DockPanel.Dock="Top"
                                Style="{StaticResource GoldButtonStyle}"
                                ToolTip="Save the selected file(s) (Ctrl+S). One file asks for a name; several ask for a folder." />
                        <DockPanel Margin="8,0,8,4" DockPanel.Dock="Top">
                            <TextBlock x:Name="DrawerSelectionText" VerticalAlignment="Center" DockPanel.Dock="Left" FontSize="11" Foreground="{StaticResource GoldBrush}" Text="No files selected" />
                            <Button Padding="6,2" Click="DrawerSelectNone_Click" Content="None" DockPanel.Dock="Right" FontSize="10" Style="{StaticResource OutlineButtonStyle}" />
                            <Button Margin="0,0,4,0" Padding="6,2" Click="DrawerSelectAll_Click" Content="All" DockPanel.Dock="Right" FontSize="10" Style="{StaticResource OutlineButtonStyle}" />
                        </DockPanel>

                        <Button Margin="8,0,8,8" Padding="0,6" Click="ClearCanvasButton_Click" Content="Clear All" DockPanel.Dock="Bottom" Style="{StaticResource GoldButtonStyle}" ToolTip="Remove every file from the canvas and drawer" />
                        <!--  Add Recent Downloads at the bottom of the drawer, opposite Save All & Clear Canvas  -->
                        <Button Margin="8"
                                Padding="0,6"
                                Click="AddRecentDownloadsButton_Click"
                                Content="Add Recent Downloads"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Loads PNG/JPG/PDF files from your Downloads folder that were downloaded in the last 5 minutes" />
                        <Button Margin="8,8,8,0"
                                Padding="0,6"
                                Click="AddFileButton_Click"
                                Content="Add File"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource OutlineButtonStyle}"
                                ToolTip="Browse for PNG, JPG or PDF files to add (Ctrl+O). You can also drop files onto this drawer." />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DrawerItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,3"
                                                Padding="6"
                                                                CornerRadius="3"
                                                                MouseLeftButtonDown="DrawerRow_MouseLeftButtonDown"
                                                                Tag="{Binding}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource NavyLightBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="#FF2F5FA8" />
                                                                            <Setter Property="BorderBrush" Value="White" />
                                                                            <Setter Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontSize="20"
                                                           MouseLeftButtonDown="DrawerIcon_MouseLeftButtonDown"
                                                           Tag="{Binding}"
                                                           Text="{Binding Icon}"
                                                           ToolTip="Double-click to save this file" />

                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           MouseLeftButtonDown="DrawerName_MouseLeftButtonDown"
                                                           Tag="{Binding}"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           ToolTip="Double-click to rename" />

                                                <TextBlock Grid.Column="2"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontSize="14"
                                                           Foreground="{StaticResource GoldBrush}"
                                                           MouseLeftButtonDown="DrawerAttach_MouseLeftButtonDown"
                                                           Tag="{Binding}"
                                                           Text="📎"
                                                           ToolTip="Attach this file to Assistant chat"
                                                           Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Column="3"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontSize="14"
                                                           Foreground="#FF81C995"
                                                           MouseLeftButtonDown="DrawerRestore_MouseLeftButtonDown"
                                                           Tag="{Binding}"
                                                           Text="&#8635;"
                                                           ToolTip="Hidden from canvas - click to show it again"
                                                           Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Column="4"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           FontSize="14"
                                                           Foreground="#FFEF9A9A"
                                                           MouseLeftButtonDown="DrawerDelete_MouseLeftButtonDown"
                                                           Tag="{Binding}"
                                                           Text="&#128465;"
                                                           ToolTip="Remove from this workspace"
                                                           Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!--  Thin, visible drag handle used to free-resize the View Stored Files drawer  -->
                <Thumb x:Name="DrawerSplitter"
                       Grid.Column="1"
                       DragDelta="DrawerSplitter_DragDelta"
                       Style="{StaticResource DrawerSplitterStyle}" />
            </Grid>

            <Border x:Name="CanvasBorder" Grid.Column="1" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid AllowDrop="True"
                          Background="{StaticResource NavyLightBrush}"
                          DragOver="Canvas_DragOver"
                          Drop="Canvas_Drop">
                        <ItemsControl x:Name="ItemsHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="2600" Height="1700" Background="Transparent" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type models:ImageItemModel}">
                                    <controls:ResizableChrome Width="{Binding Width}"
                                                               Height="{Binding Height}"
                                                               Zoom="{Binding Zoom, Mode=TwoWay}"
                                                               FileName="{Binding DisplayName}"
                                                               RemoveRequested="Chrome_RemoveRequested">
                                        <controls:ResizableChrome.InnerContent>
                                            <Image Source="{Binding Image}" Stretch="Fill" />
                                        </controls:ResizableChrome.InnerContent>
                                    </controls:ResizableChrome>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type models:PdfItemModel}">
                                    <controls:ResizableChrome Width="{Binding Width}"
                                                               Height="{Binding Height}"
                                                               Zoom="{Binding Zoom, Mode=TwoWay}"
                                                               FileName="{Binding DisplayName}"
                                                               RemoveRequested="Chrome_RemoveRequested">
                                        <controls:ResizableChrome.InnerContent>
                                            <controls:PdfBoxControl FilePath="{Binding FilePath}" SourceBytes="{Binding FileBytes}" />
                                        </controls:ResizableChrome.InnerContent>
                                    </controls:ResizableChrome>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</Window>
