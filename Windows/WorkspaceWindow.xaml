<Window x:Class="HexxcorpDocumentReviewUtility.Windows.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HexxcorpDocumentReviewUtility.Controls"
        xmlns:models="clr-namespace:HexxcorpDocumentReviewUtility.Models"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hexxcorp Document Review Utility - Workspace"
        Width="1100"
        Height="720"
        MinWidth="640"
        MinHeight="420"
        Closing="WorkspaceWindow_Closing"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <DockPanel>
        <!--  Toolbar  -->
        <Border Padding="10,8" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Top">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Style="{StaticResource HeaderTextStyle}"
                           Text="Reference Workspace"
                           FontSize="16" />

                <Button Margin="16,0,0,0"
                        Click="SaveLayoutButton_Click"
                        Content="Save Workspace..."
                        DockPanel.Dock="Left"
                        Style="{StaticResource GoldButtonStyle}" />
                <Button Margin="8,0,0,0"
                        Click="LoadLayoutButton_Click"
                        Content="Load Workspace..."
                        DockPanel.Dock="Left"
                        Style="{StaticResource GoldButtonStyle}" />

                <Button Margin="8,0,0,0"
                        Click="NewWorkspaceButton_Click"
                        Content="New Workspace"
                        DockPanel.Dock="Left"
                        Style="{StaticResource GoldButtonStyle}"
                        ToolTip="Clear everything and start fresh without closing the workspace" />

                <Button x:Name="ModeToggleButton"
                        Margin="16,0,0,0"
                        Click="ModeToggleButton_Click"
                        Content="Mode: Driver File"
                        DockPanel.Dock="Left"
                        FontWeight="Bold"
                        MinWidth="190"
                        Style="{StaticResource GoldButtonStyle}"
                        ToolTip="Click to switch review mode: Driver File / Full Unit (driver + equipment) / Post-Review Audit" />

                <Border x:Name="AuditDatePanel"
                        Margin="12,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="#FF7F1D1D"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        DockPanel.Dock="Left"
                        ToolTip="Post-Review Audit: this Qualified Date is treated as the current day. Linked to the Day Qualified field."
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WhiteBrush}" Text="AUDIT AS OF (Qualified Date):" />
                        <TextBox x:Name="AuditDateBox"
                                 Width="116"
                                 Height="32"
                                 Padding="6,2"
                                 FontSize="15"
                                 FontWeight="Bold"
                                 Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"
                                 MaxLength="10"
                                 PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput"
                                 Style="{StaticResource GoldTextBoxStyle}"
                                 TextChanged="AuditDateBox_TextChanged" />
                    </StackPanel>
                </Border>

                <Button Margin="0,0,8,0"
                        Click="HideWorkspaceButton_Click"
                        Content="Hide Workspace"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}" />
                <Button x:Name="FileDetailsToggleButton"
                        Margin="0,0,8,0"
                        Click="FileDetailsToggleButton_Click"
                        Content="View/Edit File Details"
                        DockPanel.Dock="Right"
                        Style="{StaticResource OutlineButtonStyle}" />
                <TextBlock x:Name="AutosaveStatusText" Visibility="Collapsed"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           FontSize="11"
                           Foreground="#FFCBD5E1" />
            </DockPanel>
        </Border>

        <!--  File details header fields (collapsible via the "View/Edit File Details" button in the top bar) - saved with the .lqw workspace file.  -->
                <Border x:Name="FileDetailsPanel"
                        Padding="10,6"
                        Background="{StaticResource NavyBrush}"
                        BorderBrush="{StaticResource NavyLightBrush}"
                        BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top"
                        Visibility="Collapsed">
                    <UniformGrid Columns="7" Rows="1">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="TRUCK NUMBER" />
                            <TextBox x:Name="TruckNumberTextBox" MaxLength="30" Style="{StaticResource GoldTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="TRAILER NUMBER" />
                            <TextBox x:Name="TrailerNumberTextBox" MaxLength="30" Style="{StaticResource GoldTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="CONTRACTOR NAME" />
                            <TextBox x:Name="ContractorNameTextBox" MaxLength="60" Style="{StaticResource GoldTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="DRIVER NAME" />
                            <TextBox x:Name="DriverNameTextBox" MaxLength="60" Style="{StaticResource GoldTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="SSN" />
                            <TextBox x:Name="SsnTextBox"
                                     MaxLength="11"
                                     PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput"
                                     Style="{StaticResource GoldTextBoxStyle}"
                                     TextChanged="SsnTextBox_TextChanged" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="FID" />
                            <TextBox x:Name="FidTextBox"
                                     MaxLength="10"
                                     PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput"
                                     Style="{StaticResource GoldTextBoxStyle}"
                                     TextChanged="FidTextBox_TextChanged" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource GoldBrush}"
                                       Text="PHONE #" />
                            <TextBox x:Name="PhoneTextBox"
                                     MaxLength="14"
                                     PreviewTextInput="DigitsOnlyTextBox_PreviewTextInput"
                                     Style="{StaticResource GoldTextBoxStyle}"
                                     TextChanged="PhoneTextBox_TextChanged" />
                        </StackPanel>
                    </UniformGrid>
                </Border>

        <!--  View/Edit Doc drawer (toggled via the "View/Edit Doc" toolbar button) - snaps open/closed and can also be freely drag-resized via the gold splitter handle, like the file drawer on the opposite side.  -->
        <Grid x:Name="WordDocDrawerHost"
              Width="0"
              DockPanel.Dock="Right"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="WordDocDrawerSplitter"
                   Grid.Column="0"
                   DragDelta="WordDocDrawerSplitter_DragDelta"
                   Style="{StaticResource DrawerSplitterStyle}" />

            <Border x:Name="NotesPanel"
                    Grid.Column="1"
                    Margin="0,8,8,8"
                    Padding="12"
                    Background="{StaticResource NavyLightBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2">
                <!--  Word document viewer - empty state shows two centered buttons; loaded state moves controls to a top bar alongside Save/Zoom.  -->
                <Border Padding="6"
                        Background="{StaticResource NavyDarkBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <StackPanel x:Name="WordDocEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button x:Name="LoadWordDocCenterButton"
                                    Padding="10,6"
                                    Click="LoadWordDocButton_Click"
                                    Content="Load Word Doc"
                                    Style="{StaticResource GoldButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Padding="10,6"
                                    Click="NewWordDocButton_Click"
                                    Content="New Doc"
                                    Style="{StaticResource OutlineButtonStyle}" />
                        </StackPanel>

                        <DockPanel x:Name="WordDocLoadedPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,6"
                                       DockPanel.Dock="Top"
                                       LastChildFill="False">
                                <Button x:Name="LoadWordDocTopButton"
                                        Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="LoadWordDocButton_Click"
                                        Content="Load Word Doc"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="NewWordDocButton_Click"
                                        Content="New Doc"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button x:Name="SaveWordDocButton"
                                        Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="SaveWordDocButton_Click"
                                        Content="Save Word Doc"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button Margin="0,0,4,0"
                                        Padding="8,3"
                                        Click="WordDocZoomOutButton_Click"
                                        Content="-"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Zoom out" />
                                <Button Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="WordDocZoomInButton_Click"
                                        Content="+"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Zoom in" />
                                <Button Padding="8,3"
                                        Click="WordDocPopOutButton_Click"
                                        Content="Pop Out"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Open this document in its own window" />
                            </DockPanel>

                            <!--  The real Microsoft Word application window is embedded here at runtime (see Services/EmbeddedWordController + Win32PanelHost) for true 1:1 view/edit/save fidelity - no custom document renderer.  -->
                            <Border Background="White"
                                    BorderBrush="#FFCBD5E1"
                                    BorderThickness="1">
                                <Grid x:Name="WordDocHostContainer" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!--  View/Edit Sheet drawer (toggled via the "View/Edit Sheet" toolbar button) - formatted the same as the Word doc viewer/editor  -->
        <Grid x:Name="ExcelDrawerHost"
              Width="0"
              DockPanel.Dock="Right"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="ExcelDrawerSplitter"
                   Grid.Column="0"
                   DragDelta="ExcelDrawerSplitter_DragDelta"
                   Style="{StaticResource DrawerSplitterStyle}" />

            <Border x:Name="ExcelPanel"
                    Grid.Column="1"
                    Margin="0,8,8,8"
                    Padding="12"
                    Background="{StaticResource NavyLightBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2">
                <!--  Excel spreadsheet viewer - empty state shows two centered buttons; loaded state moves controls to a top bar alongside Save/Zoom/Pop Out.  -->
                <Border Padding="6"
                        Background="{StaticResource NavyDarkBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <StackPanel x:Name="ExcelEmptyStatePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button x:Name="LoadExcelSheetCenterButton"
                                    Padding="10,6"
                                    Click="LoadExcelSheetButton_Click"
                                    Content="Load Sheet"
                                    Style="{StaticResource GoldButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Padding="10,6"
                                    Click="NewExcelSheetButton_Click"
                                    Content="New Sheet"
                                    Style="{StaticResource OutlineButtonStyle}" />
                            <Button Margin="8,0,0,0"
                                    Padding="10,6"
                                    Click="OpenTrackerDrawerButton_Click"
                                    Content="Dates &amp; Work History"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    ToolTip="Open the shared Dates &amp; Employment History tracker / calculator" />
                        </StackPanel>

                        <DockPanel x:Name="ExcelLoadedPanel" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,6"
                                       DockPanel.Dock="Top"
                                       LastChildFill="False">
                                <Button x:Name="LoadExcelSheetTopButton"
                                        Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="LoadExcelSheetButton_Click"
                                        Content="Load Sheet"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="NewExcelSheetButton_Click"
                                        Content="New Sheet"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button x:Name="SaveExcelSheetButton"
                                        Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="SaveExcelSheetButton_Click"
                                        Content="Save Sheet"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}" />
                                <Button Margin="0,0,4,0"
                                        Padding="8,3"
                                        Click="ExcelZoomOutButton_Click"
                                        Content="-"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Zoom out" />
                                <Button Margin="0,0,6,0"
                                        Padding="8,3"
                                        Click="ExcelZoomInButton_Click"
                                        Content="+"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Zoom in" />
                                <Button Padding="8,3"
                                        Click="ExcelPopOutButton_Click"
                                        Content="Pop Out"
                                        FontSize="11"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Open this spreadsheet in its own window" />
                            </DockPanel>

                            <!--  The real Microsoft Excel application window is embedded here at runtime (see Services/EmbeddedExcelController + Win32PanelHost) for true 1:1 view/edit/save fidelity  -->
                            <Border Background="White"
                                    BorderBrush="#FFCBD5E1"
                                    BorderThickness="1">
                                <Grid x:Name="ExcelSheetHostContainer" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!--  View Browser drawer (toggled via the "Browser" toolbar button) - opens onto the same shelf as View/Edit Doc, positioned side-by-side when both are open with an individual resize bar  -->
        <Grid x:Name="BrowserDrawerHost"
              Width="0"
              DockPanel.Dock="Right"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="BrowserDrawerSplitter"
                   Grid.Column="0"
                   DragDelta="BrowserDrawerSplitter_DragDelta"
                   Style="{StaticResource DrawerSplitterStyle}" />

            <Border x:Name="BrowserPanel"
                    Grid.Column="1"
                    Margin="0,8,8,8"
                    Padding="12"
                    Background="{StaticResource NavyLightBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2">
                <Border Padding="6"
                        Background="{StaticResource NavyDarkBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <!-- Top toolbar with navigation, address bar, go, and quick links -->
                        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                            <!-- Left controls: Back, Forward, Refresh, Home -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button x:Name="BrowserBackButton"
                                        Padding="6,3"
                                        Margin="0,0,3,0"
                                        Click="BrowserBackButton_Click"
                                        Content="◀"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Go back" />
                                <Button x:Name="BrowserForwardButton"
                                        Padding="6,3"
                                        Margin="0,0,3,0"
                                        Click="BrowserForwardButton_Click"
                                        Content="▶"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Go forward" />
                                <Button x:Name="BrowserRefreshButton"
                                        Padding="6,3"
                                        Margin="0,0,3,0"
                                        Click="BrowserRefreshButton_Click"
                                        Content="⟳"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Reload" />
                                <Button x:Name="BrowserHomeButton"
                                        Padding="6,3"
                                        Margin="0,0,6,0"
                                        Click="BrowserHomeButton_Click"
                                        Content="⌂"
                                        FontSize="12"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        ToolTip="Open a blank page" />
                            </StackPanel>

                            <!-- Right controls -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="BrowserGoButton"
                                        Padding="8,3"
                                        Margin="4,0,6,0"
                                        Click="BrowserGoButton_Click"
                                        Content="Go"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Style="{StaticResource GoldButtonStyle}" />
                            </StackPanel>

                            <!-- Center: Address Bar -->
                            <TextBox x:Name="BrowserUrlTextBox"
                                     Style="{StaticResource GoldTextBoxStyle}"
                                     FontSize="11"
                                     Padding="4,2"
                                     KeyDown="BrowserUrlTextBox_KeyDown" />
                        </DockPanel>

                        <!-- Browser Status / Loading bar -->
                        <TextBlock x:Name="BrowserStatusText"
                                   DockPanel.Dock="Bottom"
                                   Margin="0,4,0,0"
                                   FontSize="10"
                                   Foreground="#FFCBD5E1"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed" />

                        <!-- WebView2 Control Container -->
                        <StackPanel x:Name="BrowserTabStrip" DockPanel.Dock="Top" Margin="0,0,0,2" Orientation="Horizontal" />
                        <Border Background="White"
                                BorderBrush="#FFCBD5E1"
                                BorderThickness="1">
                            <Grid x:Name="BrowserTabHost">
                                <wv2:WebView2 x:Name="BrowserWebView" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!--  View Co-Pilot drawer (toggled via the "View Co-Pilot" toolbar button) - opens onto the same shelf, positioned side-by-side with resizable splitter  -->
        <Grid x:Name="CopilotDrawerHost"
              Width="0"
              DockPanel.Dock="Right"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Thumb x:Name="CopilotDrawerSplitter"
                   Grid.Column="0"
                   DragDelta="CopilotDrawerSplitter_DragDelta"
                   Style="{StaticResource DrawerSplitterStyle}" />

            <Border x:Name="CopilotPanel"
                    Grid.Column="1"
                    Margin="0,8,8,8"
                    Padding="10"
                    Background="{StaticResource NavyLightBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2">
                <Border Padding="6"
                        Background="{StaticResource NavyDarkBrush}"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel>
                        <!-- Top action bar with Assistant trigger buttons -->
                        <DockPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                            <!-- Status text indicator -->
                            <TextBlock x:Name="CopilotStatusText"
                                       Margin="0,4,0,0"
                                       DockPanel.Dock="Bottom"
                                       FontSize="10"
                                       Foreground="{StaticResource GoldBrush}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- 2-column action bar: Primary review actions on left, Dates off to the side on right -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left section: Review & analysis actions -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <!-- Row 1: Primary Qualification Actions -->
                                    <WrapPanel Margin="0,0,0,4" Orientation="Horizontal">
                                        <Button x:Name="CopilotAuditButton"
                                                Margin="0,0,4,4"
                                                Padding="8,4"
                                                Click="CopilotAuditButton_Click"
                                                Content="Audit File &amp; Report Issues"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Style="{StaticResource GoldButtonStyle}"
                                                ToolTip="Review supplied documents against applicable DOT references and configured criteria, then extract supported details" />
                                        <Button x:Name="CopilotSummarizeButton"
                                                Margin="0,0,4,4"
                                                Padding="8,4"
                                                Click="CopilotSummarizeButton_Click"
                                                Content="Driver Summarization"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Style="{StaticResource GoldButtonStyle}"
                                                ToolTip="Generate driver summarization: frontloaded short summary followed by detailed nitty-gritty analysis" />
                                        <Button x:Name="CopilotDraftRejectEmailButton"
                                                Margin="0,0,4,4"
                                                Padding="8,4"
                                                Click="CopilotDraftRejectEmailButton_Click"
                                                Content="Draft Review Notes"
                                                FontSize="11"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                ToolTip="Draft a concise rejection email listing all file defects and problem points in as few words as possible" />
                                    </WrapPanel>

                                    <!-- Row 2: Automation & Utility Controls -->
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="CopilotReloadButton"
                                                Padding="6,3"
                                                Click="CopilotReloadButton_Click"
                                                Content="⟳ Reload"
                                                FontSize="10"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                ToolTip="Reload the review assistant" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Right section (off to the side): Gather Dates & Apply Suggested Dates -->
                                <Border Grid.Column="1"
                                        Padding="8,0,0,0"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="1,0,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <Button x:Name="CopilotGatherDatesButton"
                                                Margin="0,0,0,4"
                                                Padding="10,4"
                                                Click="CopilotGatherDatesButton_Click"
                                                Content="📅 Gather All Dates"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Style="{StaticResource GoldButtonStyle}"
                                                ToolTip="Prompt the assistant to extract dates and details from attached documents" />
                                        <Button x:Name="CopilotApplyDatesButton"
                                                Padding="10,4"
                                                Background="{StaticResource GoldBrush}"
                                                BorderThickness="1"
                                                Click="CopilotApplyDatesButton_Click"
                                                Content="📥 Apply Suggested Dates"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource DarkTextBrush}"
                                                ToolTip="Read extracted dates/fields from Assistant's response or clipboard and apply directly to the file" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DockPanel>

                        <!-- Embedded assistant page; sign-in is controlled by the user's chosen service. -->
                        <Border Background="White"
                                BorderBrush="#FFCBD5E1"
                                BorderThickness="1">
                            <wv2:WebView2 x:Name="CopilotWebView" />
                        </Border>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>

        <!--  Dates & Work History tracker drawer - leftmost of the shelf drawers, shares one model with the main window drawer and the File Dates boxes  -->
        <Grid x:Name="TrackerDrawerHost"
              Width="0"
              DockPanel.Dock="Right"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Thumb Grid.Column="0"
                   DragDelta="TrackerDrawerSplitter_DragDelta"
                   Style="{StaticResource DrawerSplitterStyle}" />
            <Border x:Name="TrackerPanelBorder"
                    Grid.Column="1"
                    Margin="0,8,8,8"
                    Padding="6"
                    Background="{StaticResource NavyLightBrush}"
                    BorderBrush="{StaticResource GoldBrush}"
                    BorderThickness="2">
                <controls:TrackerPanel x:Name="TrackerPanelHost" />
            </Border>
        </Grid>

        <!--  Quick Date Reference bar  -->
        <Border Padding="10,8"
                Background="{StaticResource NavyDarkBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="0,2,0,0"
                DockPanel.Dock="Bottom">
            <DockPanel LastChildFill="True">
                <!--  Toggles the 7-milestone bar between "past" (subtract, oldest-first) and "future" (add, youngest-first) modes.  -->
                <Button x:Name="DateDirectionToggleButton"
                        Width="78"
                        Margin="0,0,12,0"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        Background="{StaticResource GoldBrush}"
                        BorderBrush="{StaticResource GoldDarkBrush}"
                        BorderThickness="2"
                        Click="DateDirectionToggleButton_Click"
                        Cursor="Hand"
                        DockPanel.Dock="Left"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource DarkTextBrush}">
                    <TextBlock x:Name="DateDirectionToggleText"
                               HorizontalAlignment="Center"
                               Text="PAST" />
                </Button>

                <!--  Backdate box: always "yesterday", or the previous Friday if today is Monday.  -->
                <Border Margin="12,0,0,0"
                        Padding="14,4"
                        Background="{StaticResource GoldBrush}"
                        BorderBrush="{StaticResource GoldDarkBrush}"
                        BorderThickness="2"
                        CornerRadius="3"
                        DockPanel.Dock="Right">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource DarkTextBrush}"
                                   Text="BACKDATE" />
                        <TextBlock x:Name="BackdateText"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkTextBrush}" />
                    </StackPanel>
                </Border>

                <!--  Seven rolling date milestones, evenly spaced to fill the remaining width. Labels and values are set in code-behind so the set/order can flip between past and future modes.  -->
                <UniformGrid Columns="7" Rows="1">
