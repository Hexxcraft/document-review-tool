<Window x:Class="HexxcorpDocumentReviewUtility.Windows.MinimumsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Criteria - Quick Reference"
        Width="620"
        Height="720"
        MinWidth="480"
        MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border Padding="16,12" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Review Criteria" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="12"
                           Foreground="#FFCBD5E1"
                           Text="DOT starter reference and editable review criteria" />
            </StackPanel>
        </Border>

        <Border Padding="10" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Bottom">
            <DockPanel>
                <Button Click="CloseButton_Click"
                        Content="Close"
                        DockPanel.Dock="Right"
                        Style="{StaticResource GoldButtonStyle}" />
                <Button HorizontalAlignment="Left"
                        Click="EditButton_Click"
                        Content="Edit Criteria..."
                        Style="{StaticResource OutlineButtonStyle}" />
            </DockPanel>
        </Border>

        <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SectionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="{Binding Title}" />
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2,0,0"
                                                   Loaded="LineTextBlock_Loaded"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,10,0,0" Background="{StaticResource GoldBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
