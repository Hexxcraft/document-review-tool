<Window x:Class="HexxcorpDocumentReviewUtility.Windows.WordDocPopoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Document"
        Width="900"
        Height="700"
        MinWidth="500"
        MinHeight="400"
        ShowInTaskbar="True"
        Style="{StaticResource AppWindowStyle}"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized">
    <DockPanel>
        <Border Padding="12,8" Background="{StaticResource NavyDarkBrush}" DockPanel.Dock="Top">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Style="{StaticResource HeaderTextStyle}"
                           Text="Word Document" />
                <Button Padding="12,6"
                        Click="PopInButton_Click"
                        Content="Pop In"
                        DockPanel.Dock="Right"
                        Style="{StaticResource GoldButtonStyle}"
                        ToolTip="Return this document to the Workspace window" />
            </DockPanel>
        </Border>

        <Border Margin="10"
                Background="White"
                BorderBrush="#FFCBD5E1"
                BorderThickness="1">
            <Grid x:Name="ContentHost" />
        </Border>
    </DockPanel>
</Window>
